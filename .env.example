# Порт сервера
PORT=3000

# OpenAI API Key (хранится строго на сервере, никогда не передается на фронтенд)
OPENAI_API_KEY=

# Модель OpenAI по умолчанию (gpt-4o-mini, gpt-4o, etc.)
OPENAI_MODEL=gpt-4o-mini

# Пароль для доступа к административной панели
ADMIN_PASSWORD=admin12345

# Входящий вебхук Bitrix24 для создания лидов (опционально)
# Пример: https://your-domain.bitrix24.ru/rest/1/webhook-code/crm.lead.add.json
BITRIX24_WEBHOOK_URL=

# Срок хранения истории диалогов (в днях)
DATA_RETENTION_DAYS=30
